<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- bluetoothd picks its HCI transport from the board-id (MacPro7,1 = UART) unless BT_HCI_TRANSPORT is set in its
	     environment. BlueToolFixup's board-id rewrite has nothing to rewrite in Tahoe's bluetoothd, so this daemon sets the
	     variable in launchd's system domain at boot, waits until the loader has marked the controller FirmwareLoaded (bluetoothd
	     only looks for an external dongle while starting up, so it must start after the device exists), then TERMs bluetoothd
	     once so its respawn starts clean (kickstart -k blocks while launchd throttles a looping service). -->
	<key>Label</key>
	<string>com.razvanccr.qcabt-transport</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/bin/launchctl setenv BT_HCI_TRANSPORT USB; i=0; while [ $i -lt 90 ]; do /usr/sbin/ioreg -r -n "Bluetooth USB Host Controller" -w0 2>/dev/null | /usr/bin/grep -q '"FirmwareLoaded" = Yes' &amp;&amp; break; /bin/sleep 1; i=$((i+1)); done; /bin/sleep 3; /bin/launchctl kill TERM system/com.apple.bluetoothd 2>/dev/null; exit 0</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>

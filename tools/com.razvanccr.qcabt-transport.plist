<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Per-user LaunchAgent (gui domain), NOT a system daemon. bluetoothd picks its HCI transport from the board-id
	     (MacPro7,1 = UART, so it boots the controller through a serial port that does not exist) unless BT_HCI_TRANSPORT
	     says otherwise. Where the variable lives matters: set in launchd's system domain it ends up in bluetoothd's own
	     environment, and with it there the daemon assumes a built-in USB controller and never runs its external-dongle
	     detection (15 s search, fatal error 114). Set in the logged-in user's gui domain it is seen by the early transport
	     check only, the dongle detection runs, and our controller is used. bluetoothd respawns by itself until this runs
	     at login, so nothing has to be restarted. See docs/04-bringup.md. -->
	<key>Label</key>
	<string>com.razvanccr.qcabt-transport</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/launchctl</string>
		<string>setenv</string>
		<string>BT_HCI_TRANSPORT</string>
		<string>USB</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
